# Copy to .env and replace every REPLACE_* value before starting the stack.
DATABASE_NAME=printair
DATABASE_USER=printair
DATABASE_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_DATABASE_PASSWORD

MINIO_ROOT_USER=printair-local
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_MINIO_PASSWORD
S3_REGION=us-east-1
S3_BUCKET=printair-documents

COOKIE_SECURE=false
PUBLIC_BASE_URL=http://localhost:5174
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
BOOTSTRAP_SHOP_SLUG=demo-cafe
BOOTSTRAP_SHOP_NAME=Demo Cafe
BOOTSTRAP_OPERATOR_EMAIL=operator@example.test
BOOTSTRAP_OPERATOR_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_AT_LEAST_12_CHARACTERS
RETENTION_HOURS=48
MAX_FILE_SIZE_BYTES=26214400
MAX_FILES_PER_SUBMISSION=5
SHOP_QUOTA_BYTES=1073741824
