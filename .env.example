# Copy to .env and replace every REPLACE_* value before starting the stack.
DATABASE_NAME=printair
DATABASE_USER=printair
DATABASE_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_DATABASE_PASSWORD
POSTGRES_HOST_PORT=5433

STORAGE_BACKEND=local
STORAGE_ROOT_DIR=/var/lib/printair/storage

COOKIE_SECURE=false
PUBLIC_BASE_URL=http://localhost:5174
DASHBOARD_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
BOOTSTRAP_SHOP_SLUG=demo-cafe
BOOTSTRAP_SHOP_NAME=Demo Cafe
BOOTSTRAP_OPERATOR_EMAIL=operator@example.test
BOOTSTRAP_OPERATOR_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_AT_LEAST_12_CHARACTERS
RETENTION_HOURS=48
SHOP_QUOTA_BYTES=1073741824

# Local Compose sends verification mail to Mailpit; it is not delivered externally.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@printair.local
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false
